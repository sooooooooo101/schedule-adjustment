# 公開 URL（ローカルなら http://localhost:3000）
APP_URL=http://localhost:3000

# セッション署名用（32 文字以上）: openssl rand -base64 48
SESSION_SECRET=

# リフレッシュトークン暗号化用（32 バイトの base64）: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud Console の OAuth クライアント（ウェブアプリケーション）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon の接続文字列（Vercel で Neon を連携すると自動で設定される）
# ローカル開発では Vercel から取得するか、手元の PostgreSQL を指定する
DATABASE_URL=
