# 公開 URL（ローカルなら http://localhost:3000）
APP_URL=http://localhost:3000

# 作成者としてログインを許可する Google アカウント（カンマ区切り）
OWNER_EMAILS=you@gmail.com,you@your-company.com

# セッション署名用（32 文字以上）: openssl rand -base64 48
SESSION_SECRET=

# リフレッシュトークン暗号化用（32 バイトの base64）: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud Console の OAuth クライアント（ウェブアプリケーション）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase の Project URL とシークレットキー（サーバー専用、公開しない）
SUPABASE_URL=
SUPABASE_SECRET_KEY=
